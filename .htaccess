# ─── Clean URLs ───────────────────────────────────────────────────────────────
# about.html wurde entfernt (Inhalt lebt im Embed-Overlay, About-Tab).
# 301 auf die Startseite für alte externe Links / Suchmaschinen-Einträge.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^about/?$ / [R=301,L]
    RewriteRule ^ueber/?$ / [R=301,L]
    RewriteRule ^about\.html$ / [R=301,L]
</IfModule>

# ─── Brotli-Komprimierung (bevorzugt, ~15% besser als gzip) ──────────────────
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS \
        text/html \
        text/css \
        text/javascript \
        application/javascript \
        application/json \
        image/svg+xml \
        font/ttf \
        font/woff \
        font/woff2
</IfModule>

# ─── Gzip-Komprimierung (Fallback) ───────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE \
        text/html \
        text/css \
        text/javascript \
        application/javascript \
        application/json \
        image/svg+xml \
        font/ttf \
        font/woff \
        font/woff2
</IfModule>

# ─── Cache-Control-Header ─────────────────────────────────────────────────────
<IfModule mod_headers.c>

    # HTML: immer beim Server nachfragen (304 wenn unverändert)
    <FilesMatch "\.(html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # JSON-Daten: 10 Minuten (locations.json aktualisiert sich selten)
    <FilesMatch "\.(json)$">
        Header set Cache-Control "max-age=600, must-revalidate"
    </FilesMatch>

    # status.json: IMMER beim Server nachfragen — Live-Öffnungsstatus,
    # muss jederzeit aktuell sein (304 wenn unverändert, dank ETag billig)
    <FilesMatch "^status\.json$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # App-JS/CSS: 48h (kein Content-Hashing; SW-Versions-Bump erneuert die
    # Caches ohnehin, sobald der Client den neuen sw.js sieht)
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "max-age=172800, stale-while-revalidate=3600"
    </FilesMatch>

    # Service Worker: IMMER beim Server nachfragen (304 wenn unverändert).
    # sw.js ist der Update-Schalter für alle anderen Caches — hinge er selbst
    # 48h im HTTP-Cache (JS-Regel oben), bekämen Geräte tagelang alte Assets.
    # Muss NACH der JS-Regel stehen, damit dieses "Header set" gewinnt.
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Schriften: 1 Jahr (ändern sich nie)
    <FilesMatch "\.(woff2|woff|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, immutable"
    </FilesMatch>

    # Bilder + Icons: 1 Woche
    <FilesMatch "\.(png|jpg|jpeg|gif|svg|ico|webp)$">
        Header set Cache-Control "max-age=604800"
    </FilesMatch>

    # Webmanifest: 1 Tag
    <FilesMatch "\.(webmanifest)$">
        Header set Cache-Control "max-age=86400"
    </FilesMatch>

</IfModule>

# ─── ETags aktivieren (für präzise 304-Antworten) ────────────────────────────
FileETag MTime Size

# ─── MIME-Typen sicherstellen ─────────────────────────────────────────────────
<IfModule mod_mime.c>
    AddType font/woff2       .woff2
    AddType font/woff        .woff
    AddType application/json .json
</IfModule>
